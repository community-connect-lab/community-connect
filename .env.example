# Local backend configuration. Restart the server after changes.
PORT=3000
DEMO_MODE=true

# Backend secret only. Copy this file to .env and replace the placeholder locally.
# Never expose MODEL_API_KEY in browser bundles, logs or version control.
MODEL_API_KEY=replace_with_your_meta_model_api_key

# Verified against official Meta Model API documentation on 2026-10-26.
MODEL_API_URL=https://api.meta.ai/v1/responses
MODEL_API_MODEL=muse-wonder-1.0
MODEL_API_TIMEOUT_MS=60000

# Separate webhook receiver configuration. Use Render environment variables when hosted.
# Generate a random verification token of at least 32 characters; keep it local.
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_verification_token
# Community Connect's Meta App secret, NOT the Graph access token.
WHATSAPP_APP_SECRET=replace_with_your_community_connect_app_secret
# Optional receiver filter: copy the shared test Phone number ID from Meta API Setup.
WHATSAPP_PHONE_NUMBER_ID=
# Local webhook port; PORT above is for the notes app. Render supplies its own PORT.
WEBHOOK_PORT=10000

# A Graph token is not required to verify/receive webhooks. It is for future Calling actions.
WHATSAPP_ACCESS_TOKEN=replace_with_your_whatsapp_system_user_token
